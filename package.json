{
  "name": "quillframe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @quillframe/web dev",
    "dev:api": "pnpm --filter @quillframe/api dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @quillframe/api start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:env": "node scripts/setup-env.mjs",
    "secret": "node scripts/secret.mjs",
    "db:migrate": "pnpm --filter @quillframe/api db:migrate",
    "db:seed": "pnpm --filter @quillframe/api db:seed",
    "db:test:create": "docker compose exec -T postgres psql -U quillframe -d quillframe -c \"CREATE DATABASE quillframe_test\"",
    "jobs": "pnpm --filter @quillframe/api jobs",
    "font:metrics": "node scripts/extract-font-metrics.mjs",
    "font:specimen": "node scripts/font-specimen.mjs",
    "font:unifont": "node scripts/unifont-subset.mjs",
    "font:web": "node scripts/font-web.mjs",
    "reference-pack": "node scripts/reference-pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
