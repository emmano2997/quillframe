# Copie para .env e ajuste (ou rode `pnpm setup:env`, que copia e gera os segredos).
# Nunca faça commit do .env (documento 02, §5.13).

NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=3000
# Origem do site: usada na checagem de Origin e nos links dos e-mails
APP_ORIGIN=http://localhost:5173
# Atrás do Render e da Cloudflare: true (o IP do cliente vem em X-Forwarded-For)
TRUST_PROXY=false

# Banco (docker compose up -d). Em produção a API usa um usuário sem permissão de alterar tabelas,
# e as migrations usam DATABASE_MIGRATION_URL.
DATABASE_URL=postgresql://quillframe:quillframe_dev_only@127.0.0.1:5432/quillframe
# DATABASE_MIGRATION_URL=
# Contadores de rate limit. Sem esta variável ficam na memória (só para desenvolvimento).
REDIS_URL=redis://127.0.0.1:6379

# Segredos: 32 bytes em base64url cada. Gere um por variável com `pnpm secret`.
# A API não sobe se faltar algum ou se tiver menos de 32 bytes.
CSRF_SECRET=
# Pepper das senhas, versionado: para trocar, crie o V2, mude o CURRENT e mantenha o V1
# até todos terem entrado de novo (o login refaz o hash).
PASSWORD_PEPPER_V1=
PASSWORD_PEPPER_CURRENT=1
# Chave AES-256 do segredo TOTP (2FA), também versionada
MFA_ENC_KEY_V1=
MFA_ENC_KEY_CURRENT=1

# E-mail. Desenvolvimento: Mailpit (http://127.0.0.1:8025). Produção: Resend (obrigatório).
MAILPIT_URL=http://127.0.0.1:8025
MAIL_FROM=quillframe <no-reply@quillframe.local>
# RESEND_API_KEY=

# Cloudflare Turnstile. Sem as chaves (desenvolvimento), a API só confere que o front enviou um token.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Login com Google e Discord (opcional). URI de retorno: <APP_ORIGIN>/api/auth/oauth/<provedor>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Contato do security.txt e e-mail que recebe os alertas dos admins
SECURITY_CONTACT=mailto:security@quillframe.local
# ADMIN_ALERT_EMAIL=

# Produção: pasta da SPA compilada, servida pela API na mesma origem
# WEB_DIST=../web/dist
# SENTRY_DSN=
